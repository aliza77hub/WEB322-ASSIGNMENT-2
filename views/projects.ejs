<!doctype html><html lang="en" data-theme="dim"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Projects | Climate Solutions</title><link rel="stylesheet" href="/css/main.css"></head><body class="min-h-screen bg-base-100"><%- include('partials/navbar') %><main class="container mx-auto px-14 py-8"><section class="hero bg-base-200 rounded-2xl py-10 mb-10"><div class="hero-content text-center"><div><h1 class="text-4xl font-bold">Explore Climate Projects</h1><p class="py-4">Browse all projects or choose a sector</p><div class="flex flex-wrap gap-2 justify-center"><a class="btn btn-sm" href="/solutions/projects">All Projects</a><% ['Electricity','Industry, Materials & Waste','Transportation','Food Agriculture, Land & Ocean (FALO)','FALO & Nature-Based Carbon Removal','Nature Based Carbon Removal'].forEach(s=>{ %><a class="btn btn-sm" href="/solutions/projects?sector=<%= encodeURIComponent(s) %>"><%= s %></a><% }) %></div></div></div></section><div class="overflow-x-auto"><table class="table table-zebra"><thead><tr><th>Title</th><th>Sector</th><th>Summary</th><th>Details</th></tr></thead><tbody><% projects.forEach(project=>{ %><tr><td class="font-semibold"><%= project.title %></td><td><a class="btn btn-sm" href="/solutions/projects?sector=<%= encodeURIComponent(project.sector) %>"><%= project.sector %></a></td><td><%= project.summary_short %></td><td><a class="btn btn-primary btn-sm" href="/solutions/projects/<%= project.id %>">Details</a></td></tr><% }) %></tbody></table></div></main></body></html>