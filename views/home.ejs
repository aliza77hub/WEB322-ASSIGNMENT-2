<!doctype html><html lang="en" data-theme="dim"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Climate Solutions</title><link rel="stylesheet" href="/css/main.css"></head><body class="min-h-screen bg-base-100"><%- include('partials/navbar') %><main class="container mx-auto px-14 py-8"><section class="hero bg-base-200 rounded-2xl py-16 mb-12"><div class="hero-content text-center"><div><h1 class="text-5xl font-bold">Climate Solutions</h1><p class="py-6">Discover inspiring projects helping create a more sustainable world.</p><a class="btn btn-primary" href="/solutions/projects">Explore Projects</a></div></div></section><section class="grid grid-cols-1 md:grid-cols-3 gap-6"><% projects.forEach(project => { %><article class="card bg-base-200 shadow-xl"><figure><img class="h-56 w-full object-cover" src="<%= project.feature_img_url %>" alt="<%= project.title %>"></figure><div class="card-body"><h2 class="card-title"><%= project.title %></h2><p><%= project.summary_short %></p><div class="card-actions justify-end"><a class="btn btn-primary" href="/solutions/projects/<%= project.id %>">Details</a></div></div></article><% }) %></section></main></body></html>