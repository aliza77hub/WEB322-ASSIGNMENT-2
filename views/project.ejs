<!doctype html><html lang="en" data-theme="dim"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Project Details | Climate Solutions</title><link rel="stylesheet" href="/css/main.css"></head><body class="min-h-screen bg-base-100"><%- include('partials/navbar') %><main class="container mx-auto px-14 py-8"><section class="hero bg-base-200 rounded-2xl py-10 mb-10"><div class="hero-content text-center"><div><h1 class="text-4xl font-bold"><%= project.title %></h1><p class="py-4">Below, you will find detailed information about the project: <%= project.title %>.</p></div></div></section><img class="w-full max-h-96 object-cover rounded-xl" src="<%= project.feature_img_url %>" alt="<%= project.title %>"><article class="prose max-w-none py-8"><h2>Introduction</h2><p><%= project.intro_short %></p><h2>Impact</h2><p><%= project.impact %></p></article><a class="btn btn-primary" href="<%= project.original_source_url %>" target="_blank" rel="noopener noreferrer">Original Source</a><section class="card bg-base-200 my-8"><div class="card-body"><h2 class="card-title">A Random Quote</h2><p id="quote">Loading quote...</p><p id="author"></p></div></section><a href="#" onclick="history.back();return false;" class="btn btn-secondary">Back</a></main><script>document.addEventListener('DOMContentLoaded',()=>{fetch('https://dummyjson.com/quotes/random').then(r=>{if(!r.ok)throw new Error('Quote unavailable');return r.json()}).then(data=>{document.getElementById('quote').textContent=data.quote;document.getElementById('author').textContent='— '+data.author}).catch(()=>{document.getElementById('quote').textContent='Quote unavailable right now.'})});</script></body></html>